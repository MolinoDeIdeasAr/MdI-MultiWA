<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/x-icon" href="/logo_MdI.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conectar WhatsApp - MdI MultiWA</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #0f172a; color: #f8fafc; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
        .card { background: #1e293b; border-radius: 16px; padding: 40px; max-width: 460px; width: 100%; text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,0.4); }
        h1 { font-size: 1.6em; margin-bottom: 8px; color: #f8fafc; }
        .subtitle { color: #94a3b8; margin-bottom: 30px; font-size: 14px; }
        #qr-wrapper { background: white; border-radius: 12px; padding: 20px; display: inline-block; margin: 0 auto 25px; width: 280px; height: 280px; display: flex; align-items: center; justify-content: center; }
        #qr-img { max-width: 260px; max-height: 260px; display: none; border-radius: 8px; }
        #estado-esperando { color: #94a3b8; font-size: 14px; }
        #estado-esperando .spinner { width: 40px; height: 40px; border: 3px solid #334155; border-top-color: #38bdf8; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 12px; }
        @keyframes spin { to { transform: rotate(360deg); } }
        #estado-conectado { display: none; background: #15803d; color: #dcfce7; padding: 20px; border-radius: 10px; margin-bottom: 20px; }
        #estado-conectado .check { font-size: 48px; margin-bottom: 8px; }
        .pasos { text-align: left; margin-bottom: 25px; }
        .paso { display: flex; align-items: flex-start; gap: 12px; padding: 10px 0; border-bottom: 1px solid #334155; font-size: 14px; color: #cbd5e1; }
        .paso:last-child { border-bottom: none; }
        .paso-num { background: #38bdf8; color: #0f172a; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px; flex-shrink: 0; margin-top: 1px; }
        #status-msg { font-size: 13px; color: #64748b; margin-bottom: 15px; min-height: 20px; }
        .btn { padding: 10px 24px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 14px; transition: opacity 0.2s; }
        .btn-primary { background: #3b82f6; color: white; }
        .btn-secondary { background: #334155; color: #f8fafc; }
        .btn:hover { opacity: 0.85; }
        .btn-group { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
    </style>
</head>
<body>
<div class="card">
    <h1>📱 Conectar WhatsApp</h1>
    <p class="subtitle">Escaneá el código QR con tu celular para vincular la cuenta</p>

    <div id="qr-wrapper">
        <div id="estado-esperando">
            <div class="spinner"></div>
            <p>Generando QR...</p>
        </div>
        <img id="qr-img" alt="Código QR">
    </div>

    <div id="estado-conectado">
        <div class="check">✅</div>
        <h2>¡WhatsApp Conectado!</h2>
        <p id="numero-conectado">Redirigiendo al panel...</p>
    </div>

    <div id="status-msg">Esperando QR del servidor...</div>

    <div class="pasos" id="pasos-section">
        <div class="paso"><div class="paso-num">1</div><span>Abrí <strong>WhatsApp</strong> en tu celular</span></div>
        <div class="paso"><div class="paso-num">2</div><span>Tocá los <strong>tres puntos</strong> (⋮) → <strong>Dispositivos vinculados</strong></span></div>
        <div class="paso"><div class="paso-num">3</div><span>Tocá <strong>"Vincular un dispositivo"</strong> y escaneá el QR de arriba</span></div>
    </div>

    <div class="btn-group">
        <button class="btn btn-secondary" onclick="history.back()">← Volver</button>
        <button class="btn btn-primary" onclick="location.reload()"> Recargar QR</button>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const qrImg = document.getElementById('qr-img');
    const estadoEsp = document.getElementById('estado-esperando');
    const estadoCon = document.getElementById('estado-conectado');
    const statusMsg = document.getElementById('status-msg');
    const pasosSec = document.getElementById('pasos-section');
    const qrWrapper = document.getElementById('qr-wrapper');

    const socket = io();
    const userId = '<%= userId %>';
    const activeId = '<%= activeId %>';

    console.log('🔧 [FRONTEND] userId =', userId, '| activeId =', activeId);

    socket.on('connect', () => {
        console.log('🔌 [FRONTEND] Conectado al socket');
        statusMsg.textContent = '🔌 Conectado al servidor, esperando QR...';
        socket.emit('join', userId);
        if (activeId && activeId !== 'undefined' && activeId !== '') {
            socket.emit('join', activeId);
            console.log(' [FRONTEND] Solicitando QR para:', activeId);
            socket.emit('request_qr', activeId);
        }
    });

    socket.on('qr', (data) => {
        console.log('📷 [FRONTEND] ¡QR RECIBIDO!', data);
        
        if (!data || !data.qr) {
            console.warn('⚠️ [FRONTEND] No hay QR en los datos');
            return;
        }

        // Ocultar spinner
        estadoEsp.style.display = 'none';
        
        // Generar QR usando API externa (más confiable)
        try {
            const qrText = encodeURIComponent(data.qr);
            const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=260x260&data=${qrText}`;
            
            qrImg.src = qrUrl;
            qrImg.style.display = 'block';
            statusMsg.textContent = '📷 Escaneá el QR con WhatsApp en tu celular';
            statusMsg.style.color = '#86efac';
            
            console.log('✅ [FRONTEND] QR mostrado correctamente');
            
            // Precargar la imagen para asegurar que se vea
            qrImg.onload = () => {
                console.log('✅ [FRONTEND] Imagen QR cargada completamente');
            };
            
            qrImg.onerror = (err) => {
                console.error('❌ [FRONTEND] Error cargando imagen QR:', err);
                statusMsg.textContent = '⚠️ Error al cargar el QR. Recargá la página.';
                statusMsg.style.color = '#fbbf24';
            };
        } catch (err) {
            console.error('❌ [FRONTEND] Error generando QR:', err);
            statusMsg.textContent = '⚠️ Error al generar el QR. Recargá la página.';
            statusMsg.style.color = '#fbbf24';
        }
    });

    socket.on('qr_waiting', (data) => {
        statusMsg.textContent = data.message || 'Generando QR...';
    });

    socket.on('whatsapp_ready', (data) => {
        console.log('✅ [FRONTEND] WhatsApp listo:', data);
        qrWrapper.style.display = 'none';
        pasosSec.style.display = 'none';
        estadoCon.style.display = 'block';
        statusMsg.textContent = '';
        setTimeout(() => { window.location.href = '/'; }, 2000);
    });

    // Timeout por si tarda mucho
    setTimeout(() => {
        if (qrImg.style.display === 'none') {
            statusMsg.textContent = '️ El QR está tardando. Probá recargar (Ctrl + F5).';
            statusMsg.style.color = '#fbbf24';
        }
    }, 60000);
</script>
</body>
</html>