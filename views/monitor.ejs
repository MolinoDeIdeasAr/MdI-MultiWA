<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Monitor | MdI MultiWA</title>
<link rel="icon" href="/logo_MdI.ico">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{background:#0f172a;color:#f8fafc;font-family:Segoe UI,Arial,sans-serif;padding:20px;}
.container{max-width:1400px;margin:auto;}
h1{color:#38bdf8;margin-bottom:20px;}
.card{background:#1e293b;border-radius:12px;padding:18px;margin-bottom:18px;border:1px solid #334155;}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:15px;}
.stat{background:#0f172a;border:1px solid #334155;border-radius:10px;padding:15px;text-align:center;}
.stat h2{font-size:34px;color:#38bdf8;}
.stat p{color:#94a3b8;margin-top:5px;}
.progress{width:100%;height:24px;background:#1e293b;border-radius:30px;overflow:hidden;}
.progress-bar{width:0%;height:100%;background:#22c55e;transition:.4s;}
.info-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;}
.info-box{background:#0f172a;border:1px solid #334155;border-radius:10px;padding:15px;}
.info-box h3{color:#38bdf8;margin-bottom:10px;}
.info-box table{width:100%;}
.info-box td{padding:6px 0;color:#cbd5e1;}
.status{padding:12px;border-radius:8px;font-weight:bold;text-align:center;margin-bottom:12px;}
.online{background:#14532d;}
.offline{background:#7f1d1d;}
.warning{background:#78350f;}
select{padding:10px;border-radius:8px;background:#0f172a;color:white;border:1px solid #334155;}
button{padding:10px 18px;border:none;border-radius:8px;cursor:pointer;color:white;font-weight:bold;}
.btn-blue{background:#2563eb;}
.btn-orange{background:#ea580c;}
.btn-red{background:#dc2626;}
.btn-green{background:#16a34a;}
table{width:100%;border-collapse:collapse;}
th{background:#1e293b;padding:10px;text-align:left;}
td{padding:9px;border-bottom:1px solid #334155;}
tbody tr:hover{background:#162032;}
.log{background:#020617;border:1px solid #334155;height:280px;overflow:auto;padding:10px;font-family:Consolas;font-size:12px;}
.badge{padding:4px 10px;border-radius:30px;font-size:12px;}
.badge-ok{background:#14532d;}
.badge-pause{background:#78350f;}
.badge-stop{background:#7f1d1d;}
.campana-badge{display:inline-block;background:#1e3a5f;color:#38bdf8;padding:4px 14px;border-radius:20px;font-size:14px;margin-left:8px;border:1px solid #38bdf8;}
.rubro-badge{display:inline-block;background:#3b2f1e;color:#fbbf24;padding:4px 14px;border-radius:20px;font-size:14px;margin-left:8px;border:1px solid #fbbf24;}
.estado-conexion{display:flex;justify-content:space-between;align-items:center;}
.estado-conexion .numero{font-size:14px;color:#94a3b8;font-weight:normal;}
</style>
</head>
<body>
<div class="container">

<!-- TÍTULO DINÁMICO: se actualiza con cada fetch -->
<h1>
📊 Monitor de Campañas
<span id="tituloCampana">
<% if (estado && estado.rubro) { %><span class="rubro-badge">🏢 <%= estado.rubro %></span><% } %>
<% if (estado && estado.tipoCampana) { %><span class="campana-badge">🏷️ <%= estado.tipoCampana %></span><% } %>
<a href="/crm" style="background: #38bdf8; color: #0f172a; padding: 10px 15px; border-radius: 6px; text-decoration: none; font-weight: bold; margin-right: 10px;">📇 CRM Clientes</a>
</span>
</h1>

<div class="card">
<form id="selectorForm">
<select id="instance">
<% instancias.forEach(i=>{ %>
<option value="<%=i.id%>" <%=activeId===i.id?'selected':''%>>
<%=i.numero || i.id%> <%=i.listo?'✅':'❌'%>
</option>
<% }) %>
</select>
<button type="button" class="btn-blue" id="btnActualizar">Actualizar</button>
</form>
</div>

<!-- NUEVO: CARTEL DE ESTADO DE CONEXIÓN DE LA INSTANCIA -->
<div id="estadoConexion" class="status offline">
🔴 Instancia desconectada
</div>

<!-- ESTADO DE LA CAMPAÑA -->
<div id="estadoWhatsapp" class="status offline">Sin actividad</div>

<div class="grid">
<div class="stat"><h2 id="stTotal">0</h2><p>Total</p></div>
<div class="stat"><h2 id="stActual">0</h2><p>Procesados</p></div>
<div class="stat"><h2 id="stEnviados">0</h2><p>Enviados</p></div>
<div class="stat"><h2 id="stPendientes">0</h2><p>Pendientes</p></div>
<div class="stat"><h2 id="stFallidos">0</h2><p>Fallidos</p></div>
<div class="stat"><h2 id="stBajas">0</h2><p>Bajas</p></div>
</div>

<div class="card">
<h3>Progreso</h3><br>
<div class="progress"><div id="barra" class="progress-bar"></div></div><br>
<div id="porcentaje" style="text-align:right">0%</div>
</div>

<div class="info-row">
<div class="info-box">
<h3>🗓 Scheduler</h3>
<table>
<tr><td>Estado</td><td id="schEstado">-</td></tr>
<tr><td>Actual</td><td id="schActual">-</td></tr>
<tr><td>Total</td><td id="schTotal">-</td></tr>
<tr><td>Próximo envío</td><td id="schNext">-</td></tr>
<tr><td>Contacto</td><td id="schContacto">-</td></tr>
</table>
</div>

<div class="info-box">
<h3>🛡 AntiBan</h3>
<table>
<tr><td>Mensajes Hoy</td><td id="abHoy">0</td></tr>
<tr><td>Mensajes Hora</td><td id="abHora">0</td></tr>
<tr><td>Motivo</td><td id="abMotivo">-</td></tr>
<tr><td>Tiempo restante</td><td id="abTiempo">-</td></tr>
</table>
</div>
</div>

<!-- CONTACTOS -->
<div class="card">
<h3>📋 Contactos</h3><br>
<div style="overflow:auto;max-height:450px;">
<table>
<thead>
<tr>
<th>#</th>
<th>Nombre</th>
<th>Número</th>
<th>Rubro</th>
<th>Estado</th>
<th>Fecha</th>
</tr>
</thead>
<tbody id="tablaContactos">
<tr><td colspan="6" style="text-align:center;color:#94a3b8;">Esperando datos...</td></tr>
</tbody>
</table>
</div>
</div>

<!-- FALLIDOS -->
<div class="card">
<h3>❌ Envíos Fallidos</h3><br>
<div style="overflow:auto;max-height:250px;">
<table>
<thead>
<tr><th>Nombre</th><th>Número</th><th>Error</th></tr>
</thead>
<tbody id="tablaFallidos">
<tr><td colspan="3" style="text-align:center;color:#94a3b8;">Sin errores</td></tr>
</tbody>
</table>
</div>
</div>

<!-- ACCIONES -->
<div class="card">
<button class="btn-orange" id="btnPausar">⏸ Pausar</button>
<button class="btn-red" id="btnDetener">⛔ Detener</button>
<button class="btn-green" onclick="location.reload()">🔄 Recargar</button>
</div>

<!-- LOGS -->
<div class="card">
<h3>📜 Logs del Sistema</h3><br>
<div id="logs" class="log">Esperando eventos...</div>
</div>

<!-- FOOTER -->
<div style="margin-top:30px;display:flex;gap:20px;flex-wrap:wrap;">
<a href="/">← Inicio</a>
<a href="/cargar">📂 Cargar contactos</a>
<a href="/conversaciones">💬 Conversaciones</a>
<a href="/bajas">🚫 Bajas</a>
<a href="/config-antibaneo">⚙ Configuración</a>
</div>

</div>

<script src="/socket.io/socket.io.js"></script>
<script>
const socket = io();
const instanceId = "<%= activeId %>";

// Función para escapar HTML y evitar inyección
function esc(s){
    if(s===null || s===undefined) return '';
    return String(s)
        .replace(/&/g,'&amp;')
        .replace(/</g,'&lt;')
        .replace(/>/g,'&gt;');
}

async function actualizar(){
    try{
        const r = await fetch(`/api/monitor/progreso?instanceId=${instanceId}`);
        const data = await r.json();
        if(!data.ok) return;

        //--------------------------------------------------
        // NUEVO: ESTADO DE CONEXIÓN DE LA INSTANCIA
        //--------------------------------------------------
        const conexion = document.getElementById('estadoConexion');
        if(data.listo){
            conexion.className = "status online estado-conexion";
            const num = data.numeroWhatsApp ? ` — ${esc(data.numeroWhatsApp)}` : '';
            conexion.innerHTML = `🟢 Instancia conectada<span class="numero">${num}</span>`;
        } else {
            conexion.className = "status offline";
            conexion.innerHTML = "🔴 Instancia desconectada";
        }

        //--------------------------------------------------
        // TÍTULO DINÁMICO (campaña + rubro)
        //--------------------------------------------------
        const titulo = document.getElementById('tituloCampana');
        if(titulo){
            let htmlTitulo = '';
            if(data.rubro){
                htmlTitulo += `<span class="rubro-badge">🏢 ${esc(data.rubro)}</span>`;
            }
            if(data.tipoCampana){
                htmlTitulo += `<span class="campana-badge">🏷️ ${esc(data.tipoCampana)}</span>`;
            }
            titulo.innerHTML = htmlTitulo;
        }

        //--------------------------------------------------
        // PROGRESO
        //--------------------------------------------------
        const p = data.progreso;
        document.getElementById('stTotal').innerText = p.total || 0;
        document.getElementById('stActual').innerText = p.actual || 0;
        document.getElementById('stEnviados').innerText = p.enviados || 0;
        document.getElementById('stPendientes').innerText = p.pendientes || 0;
        document.getElementById('stFallidos').innerText = p.fallidos || 0;
        document.getElementById('stBajas').innerText = p.bajas || 0;
        document.getElementById('barra').style.width = p.porcentaje + "%";
        document.getElementById('porcentaje').innerText = p.porcentaje + "%";

        //--------------------------------------------------
        // ESTADO DE LA CAMPAÑA
        //--------------------------------------------------
        const estado = document.getElementById('estadoWhatsapp');
        const btnPausar = document.getElementById('btnPausar');
        if(data.enviando){
            estado.className="status online";
            estado.innerHTML="🟢 Campaña en ejecución";
            btnPausar.innerText = "⏸ Pausar";
            btnPausar.className = "btn-orange";
        } else if(data.campanaFinalizada){
            estado.className="status warning";
            estado.innerHTML="✅ Campaña finalizada";
            btnPausar.innerText = "⏸ Pausar";
            btnPausar.className = "btn-orange";
        } else if(data.pausado){
            estado.className="status warning";
            estado.innerHTML="⏸ Campaña pausada";
            btnPausar.innerText = "▶ Reanudar";
            btnPausar.className = "btn-green";
        } else {
            estado.className="status offline";
            estado.innerHTML="⏸ Sin actividad";
            btnPausar.innerText = "⏸ Pausar";
            btnPausar.className = "btn-orange";
        }

        //--------------------------------------------------
        // SCHEDULER
        //--------------------------------------------------
        const s = data.scheduler || {};
        document.getElementById('schEstado').innerText = s.status || '-';
        document.getElementById('schActual').innerText = s.actual ?? '-';
        document.getElementById('schTotal').innerText = s.total ?? '-';
        document.getElementById('schContacto').innerText = s.contactoActual || '-';
        document.getElementById('schNext').innerText = s.nextRun ? new Date(s.nextRun).toLocaleTimeString() : '-';

        //--------------------------------------------------
        // ANTIBAN
        //--------------------------------------------------
        const a = data.antiban || {};
        document.getElementById('abHoy').innerText = a.mensajesHoy ?? 0;
        document.getElementById('abHora').innerText = a.mensajesHora ?? 0;
        document.getElementById('abMotivo').innerText = a.motivo || '-';
        document.getElementById('abTiempo').innerText = a.tiempoRestante ? a.tiempoRestante + " s" : "-";

        //--------------------------------------------------
        // CONTACTOS
        //--------------------------------------------------
        let html='';
        (data.contactos || []).forEach((c,i)=>{
            const rubroContacto = c.rubro || data.rubro || '-';
            html+=`<tr>
                <td>${i+1}</td>
                <td>${esc(c.nombre) || '-'}</td>
                <td>${esc(c.numero) || '-'}</td>
                <td>${esc(rubroContacto)}</td>
                <td>${esc(c.estadoEnvio) || '-'}</td>
                <td>${c.fechaEnvio ? new Date(c.fechaEnvio).toLocaleString('es-AR',{timeZone:'America/Argentina/Buenos_Aires',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}) : '-'}</td>
            </tr>`;
        });
        if(html===''){
            html=`<tr><td colspan="6" style="text-align:center">Sin contactos</td></tr>`;
        }
        document.getElementById('tablaContactos').innerHTML=html;

        //--------------------------------------------------
        // FALLIDOS
        //--------------------------------------------------
        let htmlFallidos='';
        (data.fallidos || []).forEach((f)=>{
            htmlFallidos+=`<tr>
                <td>${esc(f.nombre) || 'Sin nombre'}</td>
                <td>${esc(f.numero) || 'Sin número'}</td>
                <td style="color:#ef4444;">${esc(f.motivo) || 'Error desconocido'}</td>
            </tr>`;
        });
        if(htmlFallidos===''){
            htmlFallidos=`<tr><td colspan="3" style="text-align:center;color:#94a3b8;">Sin errores</td></tr>`;
        }
        document.getElementById('tablaFallidos').innerHTML=htmlFallidos;

    } catch(err){
        console.error(err);
    }
}

setInterval(actualizar, 1000);
actualizar();

document.getElementById('btnActualizar').onclick=actualizar;

document.getElementById('btnPausar').onclick=()=>{
    const btn = document.getElementById('btnPausar');
    const esReanudar = btn.innerText.includes('Reanudar');
    const endpoint = esReanudar ? '/api/monitor/reanudar' : '/api/monitor/pausar';
    fetch(endpoint,{
        method:'POST',
        headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify({ instanceId: instanceId })
    })
    .then(r=>r.json())
    .then(d=>{
        if(d.ok){
            alert(esReanudar ? '▶ Campaña reanudada' : '⏸ Campaña pausada');
            actualizar();
        } else {
            alert('❌ ' + (d.error || (esReanudar ? 'No se pudo reanudar' : 'No se pudo pausar')));
        }
    })
    .catch(e=>alert('❌ ' + e.message));
};

document.getElementById('btnDetener').onclick=()=>{
    if(!confirm("¿Detener campaña?")) return;
    fetch('/api/monitor/detener',{
        method:'POST',
        headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify({ instanceId: instanceId })
    })
    .then(r=>r.json())
    .then(d=>{
        if(d.ok){
            alert('⛔ Campaña detenida');
            actualizar();
        } else {
            alert('❌ ' + (d.error || 'No se pudo detener'));
        }
    })
    .catch(e=>alert('❌ ' + e.message));
};

document.getElementById('instance').onchange=function(){ location.href="/monitor?instanceId="+this.value; };

socket.on("server_log", log=>{
    const div=document.getElementById("logs");
    div.innerHTML+=log.message+"<br>";
    div.scrollTop=div.scrollHeight;
});
</script>
</body>
</html>