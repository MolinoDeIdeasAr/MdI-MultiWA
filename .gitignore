# ==========================
# MdI MultiWA - .gitignore
# ==========================

# Dependencias
node_modules/

# Variables de entorno
.env
.env.*

# WhatsApp
.wwebjs_auth/
.wwebjs_cache/
sessions/
chrome-profiles/

# Temporales
tmp/
temp/
logs/
*.log

# Archivos del sistema
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/

# Archivos de respaldo
*.bak
*.old
*.orig

# Python
__pycache__/
*.pyc

# Archivos de sesión
*.session

# Archivos privados
claves.pdf
*.lnk
.continue/
.clinerules

# Excels temporales
archivo_drive.xlsx

# Reportes
reportes/
*.csv

# ==========================
# DATOS PRIVADOS
# ==========================
users.json
estado.json
estado_guardado.json
historial_numeros.json
CRM_MdI.xlsx
CRM_Molino_Ideas_Master.xlsx
MdI_MultiWA_Seguimiento.docx

# TODA la carpeta data/ excepto .gitkeep
data/*
!data/.gitkeep

# Imágenes de campaña
uploads/*.jpg
uploads/*.png
uploads/*.jpeg
uploads/*.gif

# Sesiones de Baileys (credenciales WhatsApp)
baileys_sessions/

# Archivos temporales
estructura-proyecto.txt
arbol-proyecto.txt